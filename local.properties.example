sdk.dir=/path/to/Android/sdk

# Required: your own Telegram API credentials from https://my.telegram.org
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# Optional built-in MTProto proxy
UM_PROXY_1_IP=
UM_PROXY_1_PORT=443
UM_PROXY_1_SECRET=

# Optional keys (leave empty to disable the feature)
SNAP_CAMERAKIT_TOKEN=
SNAP_CAMERAKIT_TOKEN_PROD=
SNAP_LENS_GROUP_ID=
YANDEX_MAPKIT_KEY=

# Mapbox: put these in ~/.gradle/gradle.properties
# MAPBOX_DOWNLOADS_TOKEN=
# MAPBOX_ACCESS_TOKEN=

# Store-review demo account: its login code is filled in automatically (see UMessageDemoLogin)
UM_DEMO_PHONE=
