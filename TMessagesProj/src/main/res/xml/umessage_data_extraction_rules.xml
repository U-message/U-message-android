<?xml version="1.0" encoding="utf-8"?>
<!-- U message: login tokens must never leave the device through cloud backup or device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="saved_tokens.xml"/>
        <exclude domain="sharedpref" path="saved_tokens_login.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="saved_tokens.xml"/>
        <exclude domain="sharedpref" path="saved_tokens_login.xml"/>
    </device-transfer>
</data-extraction-rules>
